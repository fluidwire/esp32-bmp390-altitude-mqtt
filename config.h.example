// config.h.example - copy this file to config.h and fill in your own values.
// config.h is .gitignore'd so your secrets never leave your machine.

#pragma once

// --- WiFi -------------------------------------------------------------------
#define WIFI_SSID      "your-wifi-ssid"
#define WIFI_PASSWORD  "your-wifi-password"

// --- MQTT broker ------------------------------------------------------------
#define MQTT_HOST       "broker.hivemq.com"
#define MQTT_PORT       1883
#define MQTT_CLIENT_ID  "fluidwire-esp32-bmp390"
#define MQTT_USER       ""
#define MQTT_PASSWORD   ""
#define MQTT_TOPIC      "fluidwire/demo/bmp390"

// --- Altitude calibration ---------------------------------------------------
// Sea-level pressure in hPa for your area and day (check a local weather
// report). 1013.25 is the standard atmosphere; a wrong value shifts altitude.
#define SEALEVEL_HPA    1013.25
